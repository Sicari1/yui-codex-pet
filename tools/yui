#!/usr/bin/env bash
# 유이 펫 알림 CLI — 아무 스크립트나 끝날 때 유이가 알려주게 한다.
#
#   yui start "학습"            작업 중으로 표시
#   yui done  "학습" "3에폭 끝"  완료(녹색 체크) 표시
#   yui fail  "빌드" "테스트 실패"
#   yui wait  "확인 필요"
#   yui clear                   표시 지우기
#   yui run -t "학습" -- python train.py
#       실행 전 작업 중 → 끝나면 종료코드에 따라 완료/실패. 종료코드는 그대로 전달한다.
#
# 배포 폴더는 YUI_PET_DIR로 지정할 수 있고, 없으면 /mnt/c/Users/*/.yui-pet 를 찾는다.
set -u

DIR="${YUI_PET_DIR:-}"
[ -z "$DIR" ] && DIR="$(ls -d /mnt/c/Users/*/.yui-pet 2>/dev/null | head -1)"
DIR="${DIR:-$HOME/.yui-pet}"
SESS="$DIR/sessions/cli"
ID="${YUI_ID:-$$}"

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

write_state() {   # write_state <phase> <title> <detail> <ttl_sec>
  mkdir -p "$SESS" 2>/dev/null
  YUI_PHASE="$1" YUI_TITLE="$2" YUI_DETAIL="$3" YUI_TTL="$4" YUI_OUT="$SESS/$ID.json" \
  python3 - <<'PY'
import json, os, tempfile, time

out = os.environ["YUI_OUT"]
now = time.time_ns()
data = {
    "source": "cli",
    "session_id": os.path.basename(out)[:-5],
    "phase": os.environ["YUI_PHASE"],
    "title": os.environ["YUI_TITLE"][:28],
    "detail": os.environ["YUI_DETAIL"][:50],
    "transcript": "",
    "ts": now,
}
ttl = float(os.environ["YUI_TTL"] or 0)
if ttl > 0:
    data["expires_at"] = now + int(ttl * 1_000_000_000)
# 훅과 같은 방식: 임시파일에 쓰고 원자적으로 교체
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(out), suffix=".tmp")
with os.fdopen(fd, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False)
os.replace(tmp, out)
PY
}

cmd="${1:-}"; shift 2>/dev/null || true
case "$cmd" in
  start)   write_state working "${1:-작업}"      "${2:-}" 0 ;;
  done)    write_state done    "${1:-작업}"      "${2:-끝났어요}" "${YUI_TTL:-12}" ;;
  fail)    write_state failed  "${1:-작업}"      "${2:-문제가 생겼어요}" "${YUI_TTL:-30}" ;;
  wait)    write_state waiting "${1:-확인 필요}" "${2:-}" 0 ;;
  clear)   rm -f "$SESS/$ID.json" 2>/dev/null; exit 0 ;;
  run)
    title=""
    while [ $# -gt 0 ]; do
      case "$1" in
        -t) title="${2:-}"; shift 2 ;;
        --) shift; break ;;
        *)  break ;;
      esac
    done
    [ $# -eq 0 ] && usage
    [ -z "$title" ] && title="$(basename "$1")"
    write_state working "$title" "실행 중" 0
    "$@"; rc=$?
    if [ $rc -eq 0 ]; then
      write_state done "$title" "끝났어요" "${YUI_TTL:-12}"
    else
      write_state failed "$title" "종료코드 $rc" "${YUI_TTL:-30}"
    fi
    exit $rc ;;
  *) usage ;;
esac
